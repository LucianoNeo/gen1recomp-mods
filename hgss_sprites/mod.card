return {
  summary = "HGSS intro portraits, overworld charsets and party icons for Yellow.",
  author = "Luciano",
  tags = { "graphics", "overhaul", "hgss", "pixel-art" },
  differences = {
    changed = {
      "the Nidoran, Professor Oak, Red and Blue intro portraits",
      "HGSS overworld sheets with native walking directions and animation frames",
      "151 full-color, animated party icons",
    },
    added = {
      "an optional crisp-display policy for integer-scaled presentation",
      "PLAYER SELECT (RED, ASH or ETHAN) for the overworld charset and battle intro",
      "a PARTY MENU toggle for the HGSS party screen and icons",
      "a PC BOX ICONS toggle for animated HGSS icons in PC storage lists",
    },
    known = {
      "Pokemon Yellow only implements Pikachu as a follower; the other party icons do not create new followers",
      "Gen 1 menu geometry remains 160x144; this pack restyles it rather than replacing gameplay screens with DS layouts",
      "battle Pokemon generation selectors and trainer art are bundled; the player battle intro follows PLAYER SELECT",
